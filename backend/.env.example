# ============================================================
# Copie para .env e ajuste. Nenhuma variavel e obrigatoria em
# desenvolvimento: sem DATABASE_URL o sistema usa um PostgreSQL
# embarcado (PGlite), gravado fora da pasta do projeto.
# ============================================================

NODE_ENV=development
PORT=4000

# --- Banco de dados ---
# Em PRODUCAO e obrigatorio. Formato:
# postgresql://usuario:senha@host/banco?sslmode=require
# DATABASE_URL=

# Onde o banco embarcado guarda os dados em desenvolvimento.
# Padrao: %LOCALAPPDATA%\controle-financeiro\pgdata
# Nunca aponte para uma pasta sincronizada (OneDrive, Dropbox):
# a sincronizacao corrompe o banco.
# PGLITE_DIR=

# Conexoes simultaneas por instancia. Em serverless, mantenha baixo.
DB_POOL_MAX=3

# --- Seguranca ---
# OBRIGATORIO em producao. Gere um valor longo e aleatorio, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# Origens permitidas (separadas por virgula). Em producao, o proprio
# dominio da aplicacao ja e aceito automaticamente.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Anexos ---
# Anexos exigem disco permanente. Em serverless ficam desligados.
MAX_UPLOAD_MB=10
# UPLOADS_ENABLED=true
