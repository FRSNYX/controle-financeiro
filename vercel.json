{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "./",
      "entrypoint": "server.js",
      "installCommand": "npm install && npm --prefix frontend install",
      "buildCommand": "npm --prefix frontend run build"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
